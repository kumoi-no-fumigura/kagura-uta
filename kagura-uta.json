   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "末いたゐや。板井の淸水。葛",
   "yomi": "",
   "jo": false,
   "pages": [
    63
   ],
   "no": 18,
   "poems": [],
   "notes": [
    {
     "a": "葛",
     "n": "細書云、有曲名耳無其歌曲",
