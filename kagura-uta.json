   "poems": [],
   "notes": [
    {
     "a": "於介",
     "n": "採物　神樂の人長の採りて舞ふ物、此歌拾遺集にも出づ",
     "k": "頭注"
    },
    {
     "a": "阿知女",
     "n": "八十氏人　神樂に集へる多くの人々也",
     "k": "頭注"
    },
    {
     "a": "於々々々",
     "n": "此歌古今集に出づ。或説　場合によりて替へ歌ふものなりといふ。みむろ　御諸のこと。此歌拾遺集にも出づ",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "kagura-uta-000005",
   "form": "uta",
