  },
  {
   "id": "kagura-uta-000038",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "湊田",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "八つながら。物もはず居りヤ。とろちなや。八つながら。とろちなや。とろちなや。",
